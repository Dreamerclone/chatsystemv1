<Window x:Class="ChatSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:ChatSystem.ViewModels;assembly=Shared"
        xmlns:infra="clr-namespace:ChatSystem.Infrastructure;assembly=Shared"
        mc:Ignorable="d"
        Title="Secure Chat" Height="650" Width="450" Background="#F0F2F5"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <infra:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <infra:ConnectionStatusColorConverter x:Key="ConnectionStatusColorConverter"/>
        <infra:MessageAlignmentConverter x:Key="MessageAlignmentConverter"/>
        <infra:MessageColorConverter x:Key="MessageColorConverter"/>
        <infra:MessageTextColorConverter x:Key="MessageTextColorConverter"/>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Style.Resources>
                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1877F2" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{Binding IsConnected, Converter={StaticResource ConnectionStatusColorConverter}}" Margin="0,0,10,0"/>
                <TextBlock Text="Secure Global Chat" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Auth & Connection Settings -->
        <Expander Grid.Row="1" Header="Login / Settings" Background="White" IsExpanded="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}">
            <Border Padding="15" Background="#F9F9F9">
                <StackPanel>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Username" FontSize="11" Foreground="Gray"/>
                            <TextBox Text="{Binding Username}" Style="{StaticResource ModernTextBox}" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Password" FontSize="11" Foreground="Gray"/>
                            <TextBox Text="{Binding Password}" Style="{StaticResource ModernTextBox}" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </UniformGrid>

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,5,0">
                            <TextBlock Text="Host" FontSize="11" Foreground="Gray"/>
                            <TextBox Text="{Binding ServerIp}" Style="{StaticResource ModernTextBox}" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                        <StackPanel Margin="5,0,0,0">
                            <TextBlock Text="Port" FontSize="11" Foreground="Gray"/>
                            <TextBox Text="{Binding Port}" Style="{StaticResource ModernTextBox}" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Register" Command="{Binding RegisterCommand}" Width="80" Height="30" Margin="0,0,10,0" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}"/>
                        <Button Content="Login" Command="{Binding LoginCommand}" Width="80" Height="30" Background="#1877F2" Foreground="White" BorderThickness="0" IsEnabled="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Expander>

        <!-- Chat Area (Only visible if logged in) -->
        <Border Grid.Row="2" Background="#FFF" Padding="10">
            <Grid>
                <TextBlock Text="Please login to view messages" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Messages}" IsEnabled="{Binding IsLoggedIn}">
                    <!-- (Template and DataTemplate same as before) -->
                    <ItemsControl.Template>
                        <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.HorizontalAlignment>
                                    <MultiBinding Converter="{StaticResource MessageAlignmentConverter}">
                                        <Binding Path="Sender.Username"/><Binding Path="DataContext.Username" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Grid.HorizontalAlignment>
                                <Border CornerRadius="12" Padding="12,8" MaxWidth="300">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource MessageColorConverter}">
                                            <Binding Path="Sender.Username"/><Binding Path="DataContext.Username" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Sender.Username}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3">
                                            <TextBlock.Foreground><MultiBinding Converter="{StaticResource MessageTextColorConverter}"><Binding Path="Sender.Username"/><Binding Path="DataContext.Username" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13">
                                            <TextBlock.Foreground><MultiBinding Converter="{StaticResource MessageTextColorConverter}"><Binding Path="Sender.Username"/><Binding Path="DataContext.Username" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}" FontSize="9" HorizontalAlignment="Right" Opacity="0.7">
                                            <TextBlock.Foreground><MultiBinding Converter="{StaticResource MessageTextColorConverter}"><Binding Path="Sender.Username"/><Binding Path="DataContext.Username" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Foreground>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="3" Background="White" BorderBrush="#EEE" BorderThickness="0,1,0,0" Padding="15,10">
            <Grid IsEnabled="{Binding IsLoggedIn}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Tag="Type a message..." FontSize="14" BorderThickness="0" Background="#F0F2F5">
                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SendCommand}"/></TextBox.InputBindings>
                </TextBox>
                <Button Content="Send" Command="{Binding SendCommand}" Grid.Column="1" Margin="10,0,0,0" Width="70" Background="#1877F2" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="17"/></Style></Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
